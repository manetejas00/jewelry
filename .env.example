PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
PREVIEW_MODE=true
BRAND_NAME=Veyora Jewels
DB_CLIENT=sqlite
DB_FILENAME=private/store.sqlite
# Production: DB_CLIENT=mysql2, PREVIEW_MODE=false, NODE_ENV=production, HTTPS APP_URL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace_database
DB_USER=replace_user
DB_PASSWORD=replace_server_side
SESSION_SECRET=replace_with_at_least_32_random_characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace_with_a_long_unique_password
SHIPPING_INR=250
FREE_SHIPPING_INR=25000
# Enable only after actual policies/contact information are configured
MERCHANT_READY=false
MERCHANT_EMAIL=
SHIPPING_POLICY=
RETURNS_POLICY=
GOLD_MAX_AGE_HOURS=48
GOLD_FEED_URL=
GOLD_FEED_TOKEN=
PRODUCT_FEED_URL=
PRODUCT_FEED_TOKEN=
PRODUCT_FEED_FILE=
SUPPLIER_NAME=Primary supplier
INVENTORY_MODE=incremental
# Default only updates stock/prices; protect merchant copy/images on existing SKUs
SUPPLIER_OVERWRITE_FIELDS=stock,fixed_price,net_weight_g,making_flat,stone_charge,other_charge
PAYMENT_MODE=test
# Live payment intentionally disabled until gateway-specific integration is installed and verified.
PAYMENT_PROVIDER=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
CRON_EXPRESSION=30 3 * * *
