PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Production APP_URL must be HTTPS. Installation of the storefront PWA requires that secure origin.
PREVIEW_MODE=true
BRAND_NAME=Veyora Jewels
DB_CLIENT=sqlite
DB_FILENAME=private/store.sqlite
# Production: DB_CLIENT=mysql2, PREVIEW_MODE=false, NODE_ENV=production, HTTPS APP_URL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace_database
DB_USER=replace_user
DB_PASSWORD=replace_server_side
SESSION_SECRET=replace_with_at_least_32_random_characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace_with_a_long_unique_password
SHIPPING_INR=250
FREE_SHIPPING_INR=25000
# Enable only after actual policies/contact information and catalogue are approved
MERCHANT_READY=false
MERCHANT_EMAIL=
SHIPPING_POLICY=
RETURNS_POLICY=
GOLD_MAX_AGE_HOURS=48
GOLD_FEED_URL=
GOLD_FEED_TOKEN=
PRODUCT_FEED_URL=
PRODUCT_FEED_TOKEN=
PRODUCT_FEED_FILE=
SUPPLIER_NAME=Primary supplier
INVENTORY_MODE=incremental
# Default only updates stock/prices; protect merchant copy/images on existing SKUs
SUPPLIER_OVERWRITE_FIELDS=stock,fixed_price,net_weight_g,making_flat,stone_charge,other_charge
PAYMENT_MODE=disabled
# Live payment intentionally disabled until gateway-specific integration is installed and verified.
PAYMENT_PROVIDER=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
CRON_EXPRESSION=30 3 * * *

# Optional coin CSV supplier feed; manual coin import needs no setup.
COIN_FEED_URL=
COIN_FEED_TOKEN=
COIN_FEED_FILE=
COIN_FEED_ENABLED=true
COIN_INVENTORY_MODE=incremental

# Verify the exact reverse proxy topology. Direct Node=0; a single trusted proxy=1.
TRUST_PROXY=0
# Persistent absolute upload directory outside versioned releases (production).
# UPLOADS_DIR=/home/account/domains/test3.avinyacarefoundation.org/public_html/uploads
# Password recovery stays disabled until a real SMTP service is configured.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Central OTPGateway. Leave the URL blank until the internal gateway is running.
# The browser never receives this URL or the namespace secret.
OTP_GATEWAY_URL=
OTP_GATEWAY_NAMESPACE=Veyora
OTP_GATEWAY_SECRET=
OTP_EMAIL_ENABLED=false
OTP_SMS_ENABLED=false
OTP_SMS_PROVIDER=
OTP_WHATSAPP_ENABLED=false
OTP_REQUIRE_REGISTER=false
OTP_REQUIRE_LOGIN=false
OTP_REQUIRE_CHECKOUT=false
OTP_PASSWORD_RESET=false
# Kaleyra SMS is a paid carrier route. Leave blank until the merchant account exists.
KALEYRA_API_KEY=
KALEYRA_SID=
KALEYRA_SMS_SENDER=
KALEYRA_SMS_ENTITY_ID=
KALEYRA_SMS_TEMPLATE_ID=
# Kaleyra WhatsApp uses an official WhatsApp Business template. It is not a free inbox.
KALEYRA_WHATSAPP_API_KEY=
KALEYRA_WHATSAPP_SID=
KALEYRA_WHATSAPP_SENDER=
KALEYRA_WHATSAPP_TEMPLATE=
# Amazon Pinpoint SMS is an alternative paid SMS provider. Set OTP_SMS_PROVIDER=pinpoint_sms.
PINPOINT_APPLICATION_ID=
PINPOINT_ACCESS_KEY=
PINPOINT_SECRET_KEY=
PINPOINT_REGION=
PINPOINT_SENDER_ID=
PINPOINT_ENTITY_ID=
PINPOINT_TEMPLATE_ID=
# Optional automatic gold adapter requires explicit currency/unit/timestamp validation
# AND merchant approval; prefer purity-specific supplier CSV rates.
GOLD_AUTO_CONVERSION_APPROVED=false

# Optional catalogue-copy drafts. The key stays on the server. Leave blank to keep the studio action unavailable.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
